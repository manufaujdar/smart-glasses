{
  "engineering_docs": [
    "QUALITY.md",
    "CONTRIBUTING.md",
    "webapp/README.md",
    "docs/architecture/*.md",
    "docs/testing/*.md",
    "release/*.md"
  ],
  "native": [
    {
      "args": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ]
    },
    {
      "args": [
        "python3",
        "-m",
        "compileall",
        "-q",
        "apps",
        "packages",
        "services",
        "tools",
        "tests"
      ]
    },
    {
      "args": [
        "node",
        "--check",
        "webapp/app.js"
      ]
    },
    {
      "args": [
        "node",
        "--check",
        "tools/lidar_wound_progress/webapp/app.js"
      ]
    },
    {
      "args": [
        "node",
        "--check",
        "tools/lidar_wound_progress/webapp/depth-adapter.js"
      ]
    },
    {
      "args": [
        "python3",
        "tools/frontend_agent/frontend_agent.py",
        "audit",
        "--json"
      ]
    }
  ],
  "browser": [
    {
      "cwd": ".quality",
      "args": [
        "npm",
        "test"
      ]
    }
  ],
  "dependencies": [
    {
      "tool": "npm",
      "cwd": ".quality",
      "args": [
        "audit",
        "--audit-level=high"
      ]
    },
    {
      "tool": "pip-audit",
      "args": [
        "--no-deps",
        "--disable-pip",
        "--strict",
        "-r",
        "requirements-integration.txt"
      ]
    }
  ]
}
